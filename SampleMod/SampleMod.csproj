<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SampleMod</AssemblyName>
    <RootNamespace>SampleMod</RootNamespace>
    <Authors>Your_Name</Authors>
    <TargetFramework>net472</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="..\Libs\*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="..\SrmlLibs\*.dll">
      <Private>false</Private>
    </Reference>
    
    <EmbeddedResource Include="modinfo.json">
      <LogicalName>modinfo.json</LogicalName>
    </EmbeddedResource>

    <ProjectReference Include="..\SRML.Editor\SRML.Editor.csproj" />
    <ProjectReference Include="..\SRML\SRML.csproj" />
    
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
