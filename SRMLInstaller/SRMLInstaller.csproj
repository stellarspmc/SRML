<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SRMLInstaller</RootNamespace>
    <AssemblyName>SRMLInstaller</AssemblyName>
    <Authors>SlimeRancherModding</Authors>
    <Version>1.1.0.0</Version>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>6f065c56-9575-45ca-846d-9660a0f80f79</_Parameter1>
    </AssemblyAttribute>
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
  </ItemGroup>

  <Target Name="CopyPayloadLibs" BeforeTargets="CoreCompile">
    <MSBuild Projects="..\SRML\SRML.csproj" Targets="Build" Properties="Configuration=$(Configuration);RuntimeIdentifier=" />
    <MSBuild Projects="..\SRML.Editor\SRML.Editor.csproj" Targets="Build" Properties="Configuration=$(Configuration);RuntimeIdentifier=" />

    <MakeDir Directories="$(ProjectDir)Libs" />

    <ItemGroup>
      <FilesToCopy Include="..\SRML\bin\$(Configuration)\net472\SRML.dll" />
      <FilesToCopy Include="..\SRML\bin\$(Configuration)\net472\SRML.xml" />
      <FilesToCopy Include="..\SRML\bin\$(Configuration)\net472\Newtonsoft.Json.dll" />
      <FilesToCopy Include="..\SRML\bin\$(Configuration)\net472\0Harmony.dll" />
      <FilesToCopy Include="..\SRML.Editor\bin\$(Configuration)\net472\SRML.Editor.dll" />
      <FilesToCopy Include="..\SRML\bin\$(Configuration)\net472\INIFileParser.dll" />
      <FilesToCopy Include="..\Libs\System.Runtime.Serialization.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ProjectDir)Libs" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
  </Target>
</Project>